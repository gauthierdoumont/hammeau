{
  "name": "hameau",
  "version": "1.8.0",
  "description": "Hameau — tes tâches de la vraie vie font grandir ton village (appli Android)",
  "private": true,
  "author": "Gauthier Doumont",
  "license": "UNLICENSED",
  "scripts": {
    "version-js": "node scripts/version.js",
    "icones": "node scripts/icone.js && npx @capacitor/assets generate --android --iconBackgroundColor \"#141a2e\" --iconBackgroundColorDark \"#141a2e\" --splashBackgroundColor \"#141a2e\" --splashBackgroundColorDark \"#141a2e\"",
    "sync": "npm run version-js && npx cap sync android",
    "test": "node scripts/verifier.js && node --test \"tests/**/*.test.js\"",
    "e2e": "node tests/e2e/parcours.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gauthierdoumont/hammeau.git"
  },
  "homepage": "https://github.com/gauthierdoumont/hammeau#readme",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@fontsource/cinzel": "^5.3.0",
    "ical.js": "^2.2.1",
    "phaser": "^3.90.0",
    "sharp": "^0.35.5"
  }
}
